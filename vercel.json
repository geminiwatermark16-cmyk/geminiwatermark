{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/media-converter", "destination": "/media-converter-v2.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/how-to-turn-off-gemini-visible-watermark", "destination": "/blog/how-to-turn-off-gemini-visible-watermark.html" },
    { "source": "/blog/clean-ai-video-without-cropping", "destination": "/blog/clean-ai-video-without-cropping.html" },
    { "source": "/blog/why-watermark-remains-after-export", "destination": "/blog/why-watermark-remains-after-export.html" },
    { "source": "/blog/visible-watermark-vs-synthid", "destination": "/blog/visible-watermark-vs-synthid.html" },
    { "source": "/blog/mp4-vs-webm-ai-video", "destination": "/blog/mp4-vs-webm-ai-video.html" },
    { "source": "/blog/clean-already-exported-ai-video", "destination": "/blog/clean-already-exported-ai-video.html" },
    { "source": "/remove-gemini-watermark", "destination": "/remove-gemini-watermark.html" },
    { "source": "/gemini-image-watermark-remover", "destination": "/gemini-image-watermark-remover.html" },
    { "source": "/gemini-video-watermark-remover", "destination": "/gemini-video-watermark-remover.html" },
    { "source": "/google-flow-watermark-remover", "destination": "/google-flow-watermark-remover.html" },
    { "source": "/veo-watermark-remover", "destination": "/veo-watermark-remover.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/refund-policy", "destination": "/refund-policy.html" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
