{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/remove-gemini-watermark", "destination": "/remove-gemini-watermark.html" },
    { "source": "/gemini-video-watermark-remover", "destination": "/gemini-video-watermark-remover.html" },
    { "source": "/veo-watermark-remover", "destination": "/veo-watermark-remover.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/refund-policy", "destination": "/refund-policy.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
